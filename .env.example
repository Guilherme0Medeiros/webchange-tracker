POSTGRES_PASSWORD=replace-with-local-password
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=webchange_dev;Username=webchange_app;Password=replace-with-local-password
WEBCHANGE_TEST_CONNECTION=Host=localhost;Port=5432;Database=webchange_test;Username=webchange_app;Password=replace-with-local-password
InternalJobs__Token=replace-with-a-long-random-secret
# DevelopmentCheckIntervalMinutes=2 accelerates active monitors only in Development.
# ManualCheckCooldownMinutes=0 enables repeated manual checks only in Development.

# Local email sandbox (Development only): saves confirmation and alert messages in ignored files.
# Email__Mode=File
# Email__FileDirectory=.local-emails
# Email__PublicBaseUrl=https://localhost:3000

# Real SMTP delivery requires all values below and verified account addresses.
# Email__Mode=Smtp
# Email__Host=smtp.example.com
# Email__Port=587
# Email__From=alerts@example.com
# Email__Username=replace-with-smtp-username
# Email__Password=replace-with-smtp-secret
# Email__PublicBaseUrl=https://your-frontend.example.com
